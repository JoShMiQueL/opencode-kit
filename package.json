{
  "name": "opencode-kit",
  "version": "1.4.0",
  "description": "Per-project agentic kit for opencode \u2014 cost-aware routing over the opencode-devin plugin (provider devin/*). Seven agents, three slash-commands, REPORT contract.",
  "type": "module",
  "bin": {
    "opencode-kit": "./install.mjs"
  },
  "files": [
    "agents/",
    "commands/",
    "install.mjs",
    "install.sh",
    "install.ps1",
    "install.cmd",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/validate-agents.mjs && node scripts/test-install.mjs",
    "validate": "node scripts/validate-agents.mjs",
    "smoke": "node scripts/test-install.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-devin",
    "devin",
    "swe",
    "agents",
    "orchestrator",
    "subagents",
    "ai",
    "coding",
    "agentic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoShMiQueL/opencode-kit.git"
  },
  "bugs": "https://github.com/JoShMiQueL/opencode-kit/issues",
  "homepage": "https://github.com/JoShMiQueL/opencode-kit#readme",
  "license": "MIT",
  "author": "JoShMiQueL",
  "engines": {
    "node": ">=16"
  }
}
